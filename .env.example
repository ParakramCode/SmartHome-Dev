# =============================================================================
# SmartHome platform — environment variables
# Copy to .env and fill in. Only Home Assistant is strictly required;
# each integration switches on once its vars are present.
# =============================================================================

# --- Home Assistant (REQUIRED) ---
HA_BASE_URL=http://localhost:8123
HA_TOKEN=your_ha_long_lived_access_token

# --- LLM (optional; enables the hybrid parser's AI fallback) ---
GEMINI_API_KEY=your_gemini_key_here

# --- Telegram dev/test channel (optional) ---
TELEGRAM_BOT_TOKEN=your_telegram_token_here

# --- WhatsApp (production channel) ---
# Choose a provider:
#   meta  = official WhatsApp Business Cloud API (needs Meta business verification)
#   whapi = Whapi.Cloud unofficial gateway (link a dedicated number via QR; no
#           Meta approval, but against Meta ToS — number can be banned)
WHATSAPP_PROVIDER=meta

# -- meta provider (WHATSAPP_PROVIDER=meta) --
WHATSAPP_TOKEN=your_meta_api_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token
WHATSAPP_APP_SECRET=your_meta_app_secret          # for HMAC webhook verification
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id

# -- whapi provider (WHATSAPP_PROVIDER=whapi) --
WHAPI_TOKEN=your_whapi_channel_token              # from panel.whapi.cloud
WHAPI_API_URL=https://gate.whapi.cloud
WHAPI_WEBHOOK_SECRET=                             # optional: webhook auth token

# --- Admin panel (optional; enables the web dashboard) ---
ADMIN_PASSWORD=your_admin_password
SESSION_SECRET=random_secret_string
ADMIN_WHATSAPP=+91XXXXXXXXXX                       # who gets watchdog alerts

# --- Server ---
PORT=3000
APP_ENV=development

# --- Watchdog (optional) ---
# Shell command the watchdog runs to restart Home Assistant if it goes down,
# e.g. on a Raspberry Pi: "sudo systemctl restart home-assistant@homeassistant"
HA_RESTART_CMD=
